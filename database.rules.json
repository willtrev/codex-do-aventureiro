{
  "rules": {
    "mesas": {
      "$codigo": {
        ".write": "auth != null && data.child('info/mestre').val() === auth.uid",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('mestre').val() === auth.uid) || data.child('mestre').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['nome', 'mestre', 'criada']) && newData.child('nome').isString() && newData.child('nome').val().length <= 120)"
        },
        "membros": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && root.child('mesas').child($codigo).child('info').exists() && ($uid === auth.uid || root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid)",
            "papel": {
              ".validate": "newData.val() === 'jogador' || root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid"
            },
            "nome": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "removidas": {
              "$ficha": {
                ".read": "auth != null && ($ficha.beginsWith(auth.uid + '_') || root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid)",
                ".write": "auth != null && (root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid || ($ficha.beginsWith(auth.uid + '_') && !newData.exists()))"
              }
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "fichas": {
          ".read": "auth != null && root.child('mesas').child($codigo).child('membros').child(auth.uid).exists()",
          "$ficha": {
            ".write": "auth != null && (($ficha.beginsWith(auth.uid + '_') && root.child('mesas').child($codigo).child('membros').child(auth.uid).exists() && !root.child('mesas').child($codigo).child('removidas').child($ficha).exists()) || root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid)"
          }
        },
        "$outro": {
          ".validate": false
        },
        "mapa": {
          ".read": "auth != null && root.child('mesas').child($codigo).child('membros').child(auth.uid).exists()",
          "config": {
            ".validate": "newData.child('colunas').isNumber() && newData.child('linhas').isNumber() && newData.child('colunas').val() <= 60 && newData.child('linhas').val() <= 60"
          },
          "fundo": {
            ".validate": "newData.isString() && newData.val().length < 2000000"
          },
          "tokens": {
            "$id": {
              ".write": "auth != null && root.child('mesas').child($codigo).child('membros').child(auth.uid).exists() && ((!data.exists() && newData.child('dono').val() === auth.uid) || (data.child('dono').val() === auth.uid && (!newData.exists() || newData.child('dono').val() === auth.uid)))",
              ".validate": "!newData.exists() || (newData.hasChildren(['x', 'y', 'dono']) && newData.child('x').isNumber() && newData.child('y').isNumber())"
            }
          }
        }
      }
    },
    "privado": {
      "$codigo": {
        ".read": "auth != null && root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid",
        ".write": "auth != null && root.child('mesas').child($codigo).child('info/mestre').val() === auth.uid"
      }
    },
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'"
      }
    }
  }
}
